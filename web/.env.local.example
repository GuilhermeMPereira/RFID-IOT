# Na maior parte dos casos não é preciso mexer em nada aqui.
#
# O cliente fala com a API pelo caminho /api, servido pelo próprio Next, que
# repassa para a API local. Mesma origem: sem CORS, e um único túnel HTTPS
# atende o celular. Definir NEXT_PUBLIC_API faz o navegador chamar aquele
# endereço diretamente, o que quebra o acesso pelo celular — localhost, no
# celular, é o próprio aparelho.

# NEXT_PUBLIC_API="http://localhost:3333"

# Endereço da API visto pelo servidor do Next, não pelo navegador.
# Só mude se a API não estiver na porta padrão.
# API_INTERNA="http://localhost:3333"

# Origens extras aceitas pelo servidor de desenvolvimento, separadas por
# vírgula. Só é preciso se for abrir pelo IP da rede local em vez do túnel.
# ORIGENS_DEV="192.168.0.42:3000"
