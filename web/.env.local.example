# Endereço da API vista pelo navegador.
# No desktop, localhost resolve. No celular, precisa ser o endereço do túnel
# HTTPS ou o IP da máquina na rede — localhost no celular é o próprio celular.
NEXT_PUBLIC_API="http://localhost:3333"

# Condição experimental da bateria de ensaios em curso. Acompanha cada leitura
# até o banco, e é por ela que o script de métricas agrupa os resultados.
# NEXT_PUBLIC_CONDICAO="aco-10mm-0g-online"

# Origens extras aceitas pelo servidor de desenvolvimento do Next, separadas
# por vírgula. Coloque aqui o IP da sua máquina na rede, aquele que o
# `npm run dev` imprime em "Network".
# ORIGENS_DEV="26.54.122.135:3000"
