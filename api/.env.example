# ---------------------------------------------------------------------------
# Banco de dados. Escolha UMA das opções abaixo.
# ---------------------------------------------------------------------------

# A) PostgreSQL em contêiner (precisa do Docker Desktop aberto):
#    docker compose up -d banco
DATABASE_URL="postgresql://auditoria:auditoria@localhost:5432/auditoria_nfc"

# B) PostgreSQL gratuito na nuvem, se o Docker não subir.
#    Crie um banco em neon.com ou supabase.com, copie a string de conexão
#    e cole aqui no lugar da linha acima. Nada mais muda no projeto.
# DATABASE_URL="postgresql://usuario:senha@host.neon.tech/auditoria_nfc?sslmode=require"

# C) Dentro do próprio docker compose, o host é o nome do serviço:
# DATABASE_URL="postgresql://auditoria:auditoria@banco:5432/auditoria_nfc"

JWT_SEGREDO="trocar-em-producao"
